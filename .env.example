# ==============================================================
# PADELITYCS — Supabase Local Development Environment
# ==============================================================
# INSTRUCCIONES:
#   1. Copia este archivo y renómbralo a .env.local
#   2. Reemplaza los valores con los de tu entorno local de Supabase
#      Ejecuta \supabase start\ y copia los valores del output.
#   3. NUNCA subas .env.local a Git. Ya está en .gitignore.
# ==============================================================

# --- Supabase Local (Docker) ---
# Obtén estos valores corriendo: supabase start
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-here

# --- Supabase Producción (Cloud) ---
# Cuando tengas tu proyecto en Supabase Cloud, reemplaza los valores aquí
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-cloud-anon-key-here
