# ==============================================================
# PADELITYCS — Variables de Entorno (Plantilla Base)
# ==============================================================
# Este archivo (.env) SI se sube a tu repositorio Git.
# NUNCA pongas claves reales de producción aquí.
# 
# Para desarrollo local: Crea un archivo `.env.local` y pon tus claves ahí.
# Para producción: Configura estas variables directamente en Vercel.
# ==============================================================

# Supabase URL (Reemplazar en .env.local con http://127.0.0.1:54321)
VITE_SUPABASE_URL="AQUI_VA_TU_SUPABASE_URL"

# Supabase Anon Key (Reemplazar en .env.local con tu clave local)
VITE_SUPABASE_ANON_KEY="AQUI_VA_TU_ANON_KEY"
